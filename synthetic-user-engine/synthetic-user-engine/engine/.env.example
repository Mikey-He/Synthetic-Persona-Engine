# Copy to engine/.env. Never commit the real file.
# The researcher console password of the local platform (its ADMIN_PASSWORD).
ADMIN_PASSWORD=
# Only for a deployed platform (for example on Vercel): its address. Leave out to use the local one.
# PLATFORM_URL=https://your-deployment.vercel.app
# Gemini API key, only a Google-approved Gemini model (CLAUDE.md rule 9).
GEMINI_API_KEY=
