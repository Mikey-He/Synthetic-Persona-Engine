      { "percent": 90, "trigger": "actual" },
      { "percent": 100, "trigger": "actual" }
    ],
    "recipients": {
      "billingAdminsAndUsers": true,
      "projectOwners": false,
      "monitoring": { "linked": false, "channelIds": [] }
    }
  }
}
